[Unit]
Description=Trader AI v2 · crypto Strategy 2 shadow (paper only)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/trader_ai_v2
ExecStart=/opt/trader_ai_v2/.venv/bin/python main.py crypto s2run
Environment=PYTHONUTF8=1
Restart=always
RestartSec=30
Nice=5

[Install]
WantedBy=multi-user.target
